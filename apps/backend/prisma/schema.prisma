generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum ParentStatus {
  ACTIVE
  INACTIVE
}

model School {
 assessmentPatterns AssessmentPattern[]
  studentImportJobs StudentImportJob[]
  admissionEnquiries AdmissionEnquiry[]
  admissionApplications AdmissionApplication[]
  admissionPayments AdmissionPayment[]
  admissionActivities AdmissionActivity[]
  admissionDocuments AdmissionDocument[]
  enrollmentMovements EnrollmentMovement[]
  staffCategoryDefinitions StaffCategoryDefinition[]
  id        String   @id @default(uuid())
  name      String
  shortName String?
  slug      String   @unique
  address   String?
  city      String?
  state     String?
  country   String?  @default("Kenya")
  phone     String?
  email     String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                     User[]
  profileOptions            SchoolProfileOption[]
  userProfileOptions        UserSchoolProfileOption[]
  settings                  SchoolSetting?
  academicYears             AcademicYear[]
  schoolClasses             SchoolClass[]
  sections                  Section[]
  subjects                  Subject[]
  academicYearSubjects      AcademicYearSubject[]
  classSubjects             ClassSubject[]
  teachers                  Teacher[]
  parentMemberships         ParentSchoolMembership[]
  roles                     Role[]
  userRoles                 UserRole[]
  staff                     Staff[]
  studentEnrollments        StudentEnrollment[]
  teacherAssignments        TeacherAcademicAssignment[]
  studentAttendance         StudentAttendance[]
  staffAttendance           StaffAttendance[]
  leaveRequests StaffLeaveRequest[]
  leaveBalances StaffLeaveBalance[]
  dailyTasks StaffDailyTask[]
  dailyOverrides DailyTimetableOverride[]
  attendancePunches AttendancePunch[]
  attendanceExceptions AttendanceExceptionRequest[]
  leaveLedger LeaveLedger[]
  attendanceDays StaffAttendanceDay[]
  attendanceAudits StaffAttendanceAudit[]
  staffScopes StaffScopeAssignment[]
  timePeriods               TimePeriod[]
  timetableEntries          TimetableEntry[]
  exams                     Exam[]
  events                    SchoolEvent[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  homeworks                 Homework[]
  lessonPlans               LessonPlan[]
  classAnnouncements        ClassAnnouncement[]
  timetableSubstitutions    TimetableSubstitution[]
  periodTimingTemplates     PeriodTimingTemplate[]
  periodTemplateAssignments PeriodTemplateAssignment[]
}

model Role {
  id          String   @id @default(uuid())
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([schoolId, code])
  @@index([code])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  @@unique([schoolId, email])
  @@unique([schoolId, username])
  @@index([email])
  @@index([username])
  id                 String     @id @default(uuid())
  schoolId           String?
  school             School?    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email              String
  username           String?
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  avatarUrl          String?
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  roles                   UserRole[]
  profileOptions          UserSchoolProfileOption[]
  student                 Student?
  teacher                 Teacher?
  parent                  Parent?
  staff                   Staff?
  markedStudentAttendance StudentAttendance[]       @relation("StudentAttendanceMarker")
  leaveApprovals StaffLeaveRequest[]
  dailyTaskActors StaffDailyTask[]
  overrideActors DailyTimetableOverride[]
  substitutionApprovals TimetableSubstitution[]
  attendanceExceptionDecisions AttendanceExceptionRequest[]
  leaveLedgerActors LeaveLedger[]
  attendanceDayActors StaffAttendanceDay[]
  attendanceAuditActors StaffAttendanceAudit[]
  staffScopes StaffScopeAssignment[]
  markedStaffAttendance   StaffAttendance[]         @relation("StaffAttendanceMarker")
  notifications           Notification[]
  auditLogs               AuditLog[]                @relation("AuditActor")
  createdPeriodTemplates  PeriodTimingTemplate[]    @relation("PeriodTemplateCreator")
  updatedPeriodTemplates  PeriodTimingTemplate[]    @relation("PeriodTemplateUpdater")
}

model UserRole {
  userId     String
  roleId     String
  schoolId   String?
  assignedAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model SchoolSetting {
 assessmentAiPolicy Json?
  studentImportPolicy Json?
  sectionCapacityPolicy Json?
  admissionsPolicy Json?
  id                String   @id @default(uuid())
  schoolId          String   @unique
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolName        String?
  timezone          String?  @default("Africa/Nairobi")
  language          String?  @default("en")
  gradingSystem     String?  @default("percentage")
  timetableRules    Json?
  attendancePolicy  String?
  examPolicy        String?
  notificationEmail String?
  logoUrl           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  operationsPolicy Json?
  coveragePolicy Json?

}

model AcademicYear {
 assessmentPatterns AssessmentPattern[]
  studentImportJobs StudentImportJob[]
  @@unique([id, schoolId])
  admissionEnquiries AdmissionEnquiry[]
  admissionApplications AdmissionApplication[]
  id        String    @id @default(uuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(false)
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  schoolClasses             SchoolClass[]
  academicYearSubjects      AcademicYearSubject[]
  classSubjects             ClassSubject[]
  studentEnrollments        StudentEnrollment[]
  teacherAssignments        TeacherAcademicAssignment[]
  timetableEntries          TimetableEntry[]
  exams                     Exam[]
  periodTimingTemplates     PeriodTimingTemplate[]
  periodTemplateAssignments PeriodTemplateAssignment[]

  @@unique([schoolId, name])
}

model SchoolClass {
  admissionEnquiries AdmissionEnquiry[]
  admissionApplications AdmissionApplication[]
  movementsFrom EnrollmentMovement[] @relation("MovementFromClass")
  movementsTo EnrollmentMovement[] @relation("MovementToClass")
  historicalAttendance StudentAttendance[] @relation("AttendanceClassHistory")
  academicGroup String?
  id             String        @id @default(uuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  name           String
  code           String?
  capacity       Int?
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sections                  Section[]
  studentEnrollments        StudentEnrollment[]
  teacherAssignments        TeacherAcademicAssignment[]
  timetableEntries          TimetableEntry[]
  examSubjects              ExamSubject[]
  classSubjects             ClassSubject[]
  periodTemplateAssignments PeriodTemplateAssignment[]

  @@unique([schoolId, academicYearId, name])
}

model Section {
  admissionApplications AdmissionApplication[]
  movementsFrom EnrollmentMovement[] @relation("MovementFromSection")
  movementsTo EnrollmentMovement[] @relation("MovementToSection")
  historicalAttendance StudentAttendance[] @relation("AttendanceSectionHistory")
  historicalMarks StudentMark[] @relation("MarkSectionHistory")
  id                        String                      @id @default(uuid())
  schoolId                  String
  school                    School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId                   String
  schoolClass               SchoolClass                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  name                      String
  capacity                  Int?
  room                      String?
  status                    String                      @default("ACTIVE")
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  studentEnrollments        StudentEnrollment[]
  teacherAssignments        TeacherAcademicAssignment[]
  timetableEntries          TimetableEntry[]
  periodTemplateAssignments PeriodTemplateAssignment[]

  @@unique([classId, name])
}

model Subject {
  academicGroups String[] @default([])
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  type        String?  @default("core")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academicYearSubjects AcademicYearSubject[]
  classSubjects        ClassSubject[]
  teacherAssignments   TeacherAcademicAssignment[]
  timetableEntries     TimetableEntry[]
  examSubjects         ExamSubject[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
}

model Staff {
  assignedEnquiries AdmissionEnquiry[]
  id          String            @id @default(uuid())
  schoolId    String
  userId      String            @unique
  employeeId  String
  staffCategory String @default("NON_TEACHING")
  staffCategoryId String?
  categoryDefinition StaffCategoryDefinition? @relation(fields:[staffCategoryId],references:[id],onDelete:Restrict)
  joiningDate DateTime?
  status      UserStatus        @default(ACTIVE)
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  attendance  StaffAttendance[]
  attendancePunches AttendancePunch[]
  attendanceExceptions AttendanceExceptionRequest[]
  attendanceAudits StaffAttendanceAudit[]
  leaveRequests StaffLeaveRequest[]
  leaveBalances StaffLeaveBalance[]
  dailyTasks StaffDailyTask[]

  @@unique([schoolId, employeeId])
}

model StaffCategoryDefinition {
 school School @relation(fields:[schoolId],references:[id],onDelete:Cascade)
 id String @id @default(uuid())
 schoolId String
 name String
 classification String
 createdAt DateTime @default(now())
 staff Staff[]
 @@unique([schoolId,name])
}

model AcademicYearSubject {
  id             String       @id @default(uuid())
  schoolId       String
  academicYearId String
  subjectId      String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@unique([academicYearId, subjectId])
  @@index([schoolId])
  @@index([subjectId])
}

model ClassSubject {
  id             String       @id @default(uuid())
  schoolId       String
  academicYearId String
  classId        String
  subjectId      String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  schoolClass    SchoolClass  @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  isMandatory    Boolean      @default(true)
  requiredPeriodsPerWeek Int  @default(1)
  preferredPeriod String?
  preferredTimeOfDay String?
  maxPeriodsPerDay Int        @default(1)
  maxConsecutive Int          @default(1)
  requiresConsecutive Boolean @default(false)
  displayOrder   Int          @default(0)
  effectiveFrom DateTime      @default(now())
  effectiveTo   DateTime?
  isActive       Boolean      @default(true)
  configVersion Int           @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([academicYearId, classId, subjectId])
  @@index([schoolId, academicYearId, classId])
  @@index([subjectId])
  preferredPeriods Int[] @default([])
  avoidPeriods Int[] @default([])
  allowConsecutive Boolean @default(false)
  preferredTeacherIds String[] @default([])
  eligibleTeacherIds String[] @default([])

}

model SchoolProfileOption {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  key         String
  label       String
  type        String   @default("text")
  description String?
  isRequired  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userProfileOptions UserSchoolProfileOption[]

  @@unique([schoolId, key])
}

model UserSchoolProfileOption {
  id        String   @id @default(uuid())
  userId    String
  schoolId  String
  optionId  String
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  option SchoolProfileOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([userId, optionId])
}

model Student {
  id          String        @id @default(uuid())
  userId      String        @unique
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentCode String        @unique
  gradeLevel  String?
  birthDate   DateTime?
  gender      Gender?
  status      StudentStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())

  studentParents StudentParent[]
  enrollments    StudentEnrollment[]
}

model StudentEnrollment {
 @@unique([id,schoolId,academicYearId])
 assessmentObservations AssessmentObservation[]
 assessmentReports AssessmentReport[]
  address String?
  admissionDate DateTime? @db.Date
  version Int @default(1)
  admissionApplication AdmissionApplication?
  movements EnrollmentMovement[]
  id                  String               @id @default(uuid())
  schoolId            String
  studentId           String
  academicYearId      String
  classId             String
  sectionId           String?
  rollNumber          String?
  admissionNumber     String
  status              String               @default("ACTIVE")
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student             Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  schoolClass         SchoolClass          @relation(fields: [classId], references: [id], onDelete: Restrict)
  section             Section?             @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  attendance          StudentAttendance[]
  marks               StudentMark[]
  homeworkSubmissions HomeworkSubmission[]

  @@unique([studentId, schoolId, academicYearId])
  @@unique([schoolId, academicYearId, admissionNumber])
  @@unique([sectionId, academicYearId, rollNumber])
  @@index([schoolId, academicYearId, classId, sectionId])
}

model StudentAttendance {
  snapshotClass SchoolClass? @relation("AttendanceClassHistory", fields: [classIdSnapshot], references: [id], onDelete: Restrict)
  snapshotSection Section? @relation("AttendanceSectionHistory", fields: [sectionIdSnapshot], references: [id], onDelete: Restrict)
  classIdSnapshot String?
  sectionIdSnapshot String?
  id           String            @id @default(uuid())
  schoolId     String
  enrollmentId String
  date         DateTime
  status       String
  remarks      String?
  markedById   String
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  markedBy     User              @relation("StudentAttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([enrollmentId, date])
  @@index([schoolId, date])
}

model StaffAttendance {
  id         String    @id @default(uuid())
  schoolId   String
  staffId    String
  date       DateTime
  status     String
  checkIn    DateTime?
  checkOut   DateTime?
  remarks    String?
  source     String    @default("MANUAL")
  unavailableFrom String?
  unavailableUntil String?
  markedAt DateTime @default(now())
  version Int @default(1)
  expectedArrivalTime String?
  markedById String
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  markedBy   User      @relation("StaffAttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([staffId, date])
  @@index([schoolId, date])
}

model Teacher {
  id                  String                      @id @default(uuid())
  userId              String                      @unique
  schoolId            String
  school              School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherCode         String
  specialization      String?
  qualification       String?
  hireDate            DateTime?
  status              TeacherStatus               @default(ACTIVE)
  createdAt           DateTime                    @default(now())
  academicAssignments TeacherAcademicAssignment[]
  timetableEntries    TimetableEntry[]

  @@unique([schoolId, teacherCode])
  timetableEligibility Json?
  capableSubjectIds String[] @default([])
  timetableWorkload Json?

}

model TeacherAcademicAssignment {
  id                 String       @id @default(uuid())
  schoolId           String
  teacherId          String
  academicYearId     String
  classId            String
  sectionId          String?
  subjectId          String?
  isClassTeacher     Boolean      @default(false)
  responsibilityType String       @default("SUBJECT_TEACHER")
  assignmentRole     String?
  isActive           Boolean      @default(true)
  startDate          DateTime?
  endDate            DateTime?
  school             School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher            Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  schoolClass        SchoolClass  @relation(fields: [classId], references: [id], onDelete: Restrict)
  section            Section?     @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subject            Subject?     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([schoolId, academicYearId, teacherId])
  @@index([classId, sectionId, subjectId])
  @@index([schoolId, academicYearId, classId, sectionId, isActive])
  @@index([teacherId, academicYearId, isActive])
}

model TimePeriod {
  id        String           @id @default(uuid())
  schoolId  String
  name      String
  startTime String
  endTime   String
  sortOrder Int
  isBreak   Boolean          @default(false)
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  entries   TimetableEntry[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([schoolId, sortOrder])
  @@unique([schoolId, name])
}

model TimetableEntry {
  id              String                  @id @default(uuid())
  schoolId        String
  academicYearId  String
  classId         String
  sectionId       String
  subjectId       String
  teacherId       String
  periodId        String?
  periodSlotId    String?
  timetableDate   DateTime?
  timetablePlanId String?
  conflictCode    String?
  isAffected      Boolean                 @default(false)
  weekday         Int
  room            String?
  school          School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  schoolClass     SchoolClass             @relation(fields: [classId], references: [id], onDelete: Restrict)
  section         Section                 @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subject         Subject                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher         Teacher                 @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  period          TimePeriod?             @relation(fields: [periodId], references: [id], onDelete: Restrict)
  periodSlot      PeriodTimingSlot?       @relation(fields: [periodSlotId], references: [id], onDelete: Restrict)
  timetablePlan   TimetablePlan?          @relation(fields: [timetablePlanId], references: [id], onDelete: Cascade)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  overrides DailyTimetableOverride[]
  substitutions   TimetableSubstitution[]

  @@unique([academicYearId, sectionId, weekday, periodId])
  @@unique([academicYearId, teacherId, weekday, periodId])
  @@unique([timetablePlanId, sectionId, weekday, periodSlotId])
  @@index([schoolId, academicYearId, classId, sectionId])
}

model SubjectTimetableRequirement {
  id                  String   @id @default(uuid())
  schoolId            String
  academicYearId      String
  classId             String
  subjectId           String
  primaryTeacherId    String
  weeklyPeriods       Int
  preferredSequences  Int[]
  maxConsecutive      Int      @default(1)
  requiresConsecutive Boolean  @default(false)
  configVersion       Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([academicYearId, classId, subjectId])
  @@index([schoolId, academicYearId, classId])
}

model TeacherAvailability {
  id             String   @id @default(uuid())
  schoolId       String
  academicYearId String
  teacherId      String
  weekday        Int
  periodSlotId   String
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([academicYearId, teacherId, weekday, periodSlotId])
}

model TimetablePlan {
  id                       String           @id @default(uuid())
  schoolId                 String
  academicYearId           String
  classId                  String
  sectionId                String
  templateId               String
  status                   String           @default("DRAFT")
  version                  Int              @default(1)
  supervisionEntries       Json             @default("[]")
  subjectConfigFingerprint String
  generatedAt              DateTime         @default(now())
  publishedAt              DateTime?
  entries                  TimetableEntry[]
  template                 PeriodTimingTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@unique([academicYearId, sectionId, version])
  @@index([schoolId, academicYearId, classId, sectionId, status])
  coverageSubstitutions TimetableSubstitution[]

}

model PeriodTimingTemplate {
  id              String                     @id @default(uuid())
  schoolId        String
  academicYearId  String
  familyId        String
  name            String
  description     String?
  workingDays     Int[]
  schoolStartTime String
  schoolEndTime   String
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  status          String                     @default("DRAFT")
  version         Int                        @default(1)
  createdById     String
  updatedById     String
  school          School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear               @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  createdBy       User                       @relation("PeriodTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User                       @relation("PeriodTemplateUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  slots           PeriodTimingSlot[]
  assignments     PeriodTemplateAssignment[]
  timetablePlans  TimetablePlan[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([schoolId, familyId, version])
  @@index([schoolId, academicYearId, status])
}

model PeriodTimingSlot {
  id                String               @id @default(uuid())
  templateId        String
  name              String
  type              String
  sequence          Int
  startTime         String
  endTime           String
  applicableDays    Int[]
  shortCode         String?
  attendanceEnabled Boolean              @default(false)
  template          PeriodTimingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  timetableEntries  TimetableEntry[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([templateId, sequence])
  coverageSubstitutions TimetableSubstitution[]

}

model PeriodTemplateAssignment {
  id             String               @id @default(uuid())
  schoolId       String
  academicYearId String
  templateId     String
  classId        String
  sectionId      String?
  effectiveFrom  DateTime
  effectiveTo    DateTime?
