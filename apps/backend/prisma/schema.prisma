generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum ParentStatus {
  ACTIVE
  INACTIVE
}

model School {
  id         String   @id @default(uuid())
  name       String
  shortName  String?
  address    String?
  city       String?
  country    String?  @default("Kenya")
  phone      String?
  email      String?
  website    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users              User[]
  profileOptions     SchoolProfileOption[]
  userProfileOptions UserSchoolProfileOption[]
  settings           SchoolSetting?
  academicYears     AcademicYear[]
  schoolClasses      SchoolClass[]
  sections           Section[]
  subjects           Subject[]
  academicYearSubjects AcademicYearSubject[]
  students           Student[]
  teachers           Teacher[]
  parents            Parent[]
  roles              Role[]
  userRoles          UserRole[]
  staff              Staff[]
}

model Role {
  id          String   @id @default(uuid())
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([schoolId, code])
  @@index([code])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                 String      @id @default(uuid())
  schoolId           String?
  school             School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email              String      @unique
  username           String?     @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  avatarUrl          String?
  status             UserStatus  @default(ACTIVE)
  mustChangePassword Boolean     @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  roles              UserRole[]
  profileOptions     UserSchoolProfileOption[]
  student            Student?
  teacher            Teacher?
  parent             Parent?
  staff              Staff?
}

model UserRole {
  userId     String
  roleId     String
  schoolId   String?
  assignedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model SchoolSetting {
  id                  String   @id @default(uuid())
  schoolId            String   @unique
  school              School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolName          String?
  timezone            String?  @default("Africa/Nairobi")
  language            String?  @default("en")
  gradingSystem       String?  @default("percentage")
  attendancePolicy    String?
  examPolicy          String?
  notificationEmail   String?
  logoUrl             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AcademicYear {
  id         String      @id @default(uuid())
  schoolId   String
  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name       String
  startDate  DateTime?
  endDate    DateTime?
  isCurrent  Boolean     @default(false)
  status     String      @default("ACTIVE")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  schoolClasses SchoolClass[]
  academicYearSubjects AcademicYearSubject[]

  @@unique([schoolId, name])
}

model SchoolClass {
  id             String        @id @default(uuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  name           String
  code           String?
  capacity       Int?
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sections       Section[]

  @@unique([schoolId, academicYearId, name])
}

model Section {
  id        String      @id @default(uuid())
  schoolId  String
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String
  capacity  Int?
  status    String      @default("ACTIVE")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([classId, name])
}

model Subject {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  type        String?  @default("core")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academicYearSubjects AcademicYearSubject[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
}

model Staff {
  id          String      @id @default(uuid())
  schoolId    String
  userId      String      @unique
  employeeId  String
  joiningDate DateTime?
  status      UserStatus  @default(ACTIVE)
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([schoolId, employeeId])
}

model AcademicYearSubject {
  id             String       @id @default(uuid())
  schoolId       String
  academicYearId String
  subjectId      String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@unique([academicYearId, subjectId])
  @@index([schoolId])
  @@index([subjectId])
}

model SchoolProfileOption {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  key         String
  label       String
  type        String   @default("text")
  description String?
  isRequired  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userProfileOptions UserSchoolProfileOption[]

  @@unique([schoolId, key])
}

model UserSchoolProfileOption {
  id        String   @id @default(uuid())
  userId    String
  schoolId  String
  optionId  String
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  option    SchoolProfileOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([userId, optionId])
}

model Student {
  id               String         @id @default(uuid())
  userId           String         @unique
  schoolId         String
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentCode      String         @unique
  admissionNumber  String?
  gradeLevel       String?
  birthDate        DateTime?
  gender           Gender?
  status           StudentStatus  @default(ACTIVE)
  createdAt        DateTime       @default(now())

  studentParents   StudentParent[]
}

model Teacher {
  id             String       @id @default(uuid())
  userId         String       @unique
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherCode    String       @unique
  specialization String?
  qualification  String?
  hireDate       DateTime?
  status         TeacherStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
}

model Parent {
  id                    String        @id @default(uuid())
  userId                String        @unique
  schoolId              String
  school                School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentCode            String        @unique
  occupation            String?
  relationshipToStudent String?
  status                ParentStatus  @default(ACTIVE)
  createdAt             DateTime      @default(now())

  studentParents        StudentParent[]
}

model StudentParent {
  id                String   @id @default(uuid())
  studentId         String
  parentId          String
  relationshipType  String   @default("guardian")
  isPrimary         Boolean  @default(false)
  createdAt         DateTime @default(now())

  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent            Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
}
