generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum ParentStatus {
  ACTIVE
  INACTIVE
}

model School {
  id        String   @id @default(uuid())
  name      String
  shortName String?
  slug      String   @unique
  address   String?
  city      String?
  state     String?
  country   String?  @default("Kenya")
  phone     String?
  email     String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                     User[]
  profileOptions            SchoolProfileOption[]
  userProfileOptions        UserSchoolProfileOption[]
  settings                  SchoolSetting?
  academicYears             AcademicYear[]
  schoolClasses             SchoolClass[]
  sections                  Section[]
  subjects                  Subject[]
  academicYearSubjects      AcademicYearSubject[]
  classSubjects             ClassSubject[]
  teachers                  Teacher[]
  parentMemberships         ParentSchoolMembership[]
  roles                     Role[]
  userRoles                 UserRole[]
  staff                     Staff[]
  studentEnrollments        StudentEnrollment[]
  teacherAssignments        TeacherAcademicAssignment[]
  studentAttendance         StudentAttendance[]
  staffAttendance           StaffAttendance[]
  timePeriods               TimePeriod[]
  timetableEntries          TimetableEntry[]
  exams                     Exam[]
  events                    SchoolEvent[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  homeworks                 Homework[]
  lessonPlans               LessonPlan[]
  classAnnouncements        ClassAnnouncement[]
  timetableSubstitutions    TimetableSubstitution[]
  periodTimingTemplates     PeriodTimingTemplate[]
  periodTemplateAssignments PeriodTemplateAssignment[]
}

model Role {
  id          String   @id @default(uuid())
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([schoolId, code])
  @@index([code])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                 String     @id @default(uuid())
  schoolId           String?
  school             School?    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email              String     @unique
  username           String?    @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  avatarUrl          String?
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  roles                   UserRole[]
  profileOptions          UserSchoolProfileOption[]
  student                 Student?
  teacher                 Teacher?
  parent                  Parent?
  staff                   Staff?
  markedStudentAttendance StudentAttendance[]       @relation("StudentAttendanceMarker")
  markedStaffAttendance   StaffAttendance[]         @relation("StaffAttendanceMarker")
  notifications           Notification[]
  auditLogs               AuditLog[]                @relation("AuditActor")
  createdPeriodTemplates  PeriodTimingTemplate[]    @relation("PeriodTemplateCreator")
  updatedPeriodTemplates  PeriodTimingTemplate[]    @relation("PeriodTemplateUpdater")
}

model UserRole {
  userId     String
  roleId     String
  schoolId   String?
  assignedAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model SchoolSetting {
  id                String   @id @default(uuid())
  schoolId          String   @unique
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolName        String?
  timezone          String?  @default("Africa/Nairobi")
  language          String?  @default("en")
  gradingSystem     String?  @default("percentage")
  attendancePolicy  String?
  examPolicy        String?
  notificationEmail String?
  logoUrl           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AcademicYear {
  id        String    @id @default(uuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(false)
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  schoolClasses             SchoolClass[]
  academicYearSubjects      AcademicYearSubject[]
  classSubjects             ClassSubject[]
  studentEnrollments        StudentEnrollment[]
  teacherAssignments        TeacherAcademicAssignment[]
  timetableEntries          TimetableEntry[]
  exams                     Exam[]
  periodTimingTemplates     PeriodTimingTemplate[]
  periodTemplateAssignments PeriodTemplateAssignment[]

  @@unique([schoolId, name])
}

model SchoolClass {
  id             String        @id @default(uuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  name           String
  code           String?
  capacity       Int?
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sections                  Section[]
  studentEnrollments        StudentEnrollment[]
  teacherAssignments        TeacherAcademicAssignment[]
  timetableEntries          TimetableEntry[]
  examSubjects              ExamSubject[]
  classSubjects             ClassSubject[]
  periodTemplateAssignments PeriodTemplateAssignment[]

  @@unique([schoolId, academicYearId, name])
}

model Section {
  id                        String                      @id @default(uuid())
  schoolId                  String
  school                    School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId                   String
  schoolClass               SchoolClass                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  name                      String
  capacity                  Int?
  room                      String?
  status                    String                      @default("ACTIVE")
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  studentEnrollments        StudentEnrollment[]
  teacherAssignments        TeacherAcademicAssignment[]
  timetableEntries          TimetableEntry[]
  periodTemplateAssignments PeriodTemplateAssignment[]

  @@unique([classId, name])
}

model Subject {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  type        String?  @default("core")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academicYearSubjects AcademicYearSubject[]
  classSubjects        ClassSubject[]
  teacherAssignments   TeacherAcademicAssignment[]
  timetableEntries     TimetableEntry[]
  examSubjects         ExamSubject[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
}

model Staff {
  id          String            @id @default(uuid())
  schoolId    String
  userId      String            @unique
  employeeId  String
  joiningDate DateTime?
  status      UserStatus        @default(ACTIVE)
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  attendance  StaffAttendance[]

  @@unique([schoolId, employeeId])
}

model AcademicYearSubject {
  id             String       @id @default(uuid())
  schoolId       String
  academicYearId String
  subjectId      String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@unique([academicYearId, subjectId])
  @@index([schoolId])
  @@index([subjectId])
}

model ClassSubject {
  id             String       @id @default(uuid())
  schoolId       String
  academicYearId String
  classId        String
  subjectId      String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  schoolClass    SchoolClass  @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  isMandatory    Boolean      @default(true)
  requiredPeriodsPerWeek Int  @default(1)
  preferredPeriod String?
  preferredTimeOfDay String?
  maxPeriodsPerDay Int        @default(1)
  maxConsecutive Int          @default(1)
  requiresConsecutive Boolean @default(false)
  displayOrder   Int          @default(0)
  effectiveFrom DateTime      @default(now())
  effectiveTo   DateTime?
  isActive       Boolean      @default(true)
  configVersion Int           @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([academicYearId, classId, subjectId])
  @@index([schoolId, academicYearId, classId])
  @@index([subjectId])
}

model SchoolProfileOption {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  key         String
  label       String
  type        String   @default("text")
  description String?
  isRequired  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userProfileOptions UserSchoolProfileOption[]

  @@unique([schoolId, key])
}

model UserSchoolProfileOption {
  id        String   @id @default(uuid())
  userId    String
  schoolId  String
  optionId  String
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  option SchoolProfileOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([userId, optionId])
}

model Student {
  id          String        @id @default(uuid())
  userId      String        @unique
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentCode String        @unique
  gradeLevel  String?
  birthDate   DateTime?
  gender      Gender?
  status      StudentStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())

  studentParents StudentParent[]
  enrollments    StudentEnrollment[]
}

model StudentEnrollment {
  id                  String               @id @default(uuid())
  schoolId            String
  studentId           String
  academicYearId      String
  classId             String
  sectionId           String?
  rollNumber          String?
  admissionNumber     String
  status              String               @default("ACTIVE")
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student             Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  schoolClass         SchoolClass          @relation(fields: [classId], references: [id], onDelete: Restrict)
  section             Section?             @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  attendance          StudentAttendance[]
  marks               StudentMark[]
  homeworkSubmissions HomeworkSubmission[]

  @@unique([studentId, schoolId, academicYearId])
  @@unique([schoolId, academicYearId, admissionNumber])
  @@unique([sectionId, academicYearId, rollNumber])
  @@index([schoolId, academicYearId, classId, sectionId])
}

model StudentAttendance {
  id           String            @id @default(uuid())
  schoolId     String
  enrollmentId String
  date         DateTime
  status       String
  remarks      String?
  markedById   String
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  markedBy     User              @relation("StudentAttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([enrollmentId, date])
  @@index([schoolId, date])
}

model StaffAttendance {
  id         String    @id @default(uuid())
  schoolId   String
  staffId    String
  date       DateTime
  status     String
  checkIn    DateTime?
  checkOut   DateTime?
  remarks    String?
  markedById String
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  markedBy   User      @relation("StaffAttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([staffId, date])
  @@index([schoolId, date])
}

model Teacher {
  id                  String                      @id @default(uuid())
  userId              String                      @unique
  schoolId            String
  school              School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherCode         String
  specialization      String?
  qualification       String?
  hireDate            DateTime?
  status              TeacherStatus               @default(ACTIVE)
  createdAt           DateTime                    @default(now())
  academicAssignments TeacherAcademicAssignment[]
  timetableEntries    TimetableEntry[]

  @@unique([schoolId, teacherCode])
}

model TeacherAcademicAssignment {
  id                 String       @id @default(uuid())
  schoolId           String
  teacherId          String
  academicYearId     String
  classId            String
  sectionId          String?
  subjectId          String?
  isClassTeacher     Boolean      @default(false)
  responsibilityType String       @default("SUBJECT_TEACHER")
  assignmentRole     String?
  isActive           Boolean      @default(true)
  startDate          DateTime?
  endDate            DateTime?
  school             School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher            Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  schoolClass        SchoolClass  @relation(fields: [classId], references: [id], onDelete: Restrict)
  section            Section?     @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subject            Subject?     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([schoolId, academicYearId, teacherId])
  @@index([classId, sectionId, subjectId])
  @@index([schoolId, academicYearId, classId, sectionId, isActive])
  @@index([teacherId, academicYearId, isActive])
}

model TimePeriod {
  id        String           @id @default(uuid())
  schoolId  String
  name      String
  startTime String
  endTime   String
  sortOrder Int
  isBreak   Boolean          @default(false)
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  entries   TimetableEntry[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([schoolId, sortOrder])
  @@unique([schoolId, name])
}

model TimetableEntry {
  id              String                  @id @default(uuid())
  schoolId        String
  academicYearId  String
  classId         String
  sectionId       String
  subjectId       String
  teacherId       String
  periodId        String?
  periodSlotId    String?
  timetableDate   DateTime?
  timetablePlanId String?
  conflictCode    String?
  isAffected      Boolean                 @default(false)
  weekday         Int
  room            String?
  school          School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  schoolClass     SchoolClass             @relation(fields: [classId], references: [id], onDelete: Restrict)
  section         Section                 @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subject         Subject                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher         Teacher                 @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  period          TimePeriod?             @relation(fields: [periodId], references: [id], onDelete: Restrict)
  periodSlot      PeriodTimingSlot?       @relation(fields: [periodSlotId], references: [id], onDelete: Restrict)
  timetablePlan   TimetablePlan?          @relation(fields: [timetablePlanId], references: [id], onDelete: Cascade)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  substitutions   TimetableSubstitution[]

  @@unique([academicYearId, sectionId, weekday, periodId])
  @@unique([academicYearId, teacherId, weekday, periodId])
  @@unique([timetablePlanId, sectionId, weekday, periodSlotId])
  @@index([schoolId, academicYearId, classId, sectionId])
}

model SubjectTimetableRequirement {
  id                  String   @id @default(uuid())
  schoolId            String
  academicYearId      String
  classId             String
  subjectId           String
  primaryTeacherId    String
  weeklyPeriods       Int
  preferredSequences  Int[]
  maxConsecutive      Int      @default(1)
  requiresConsecutive Boolean  @default(false)
  configVersion       Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([academicYearId, classId, subjectId])
  @@index([schoolId, academicYearId, classId])
}

model TeacherAvailability {
  id             String   @id @default(uuid())
  schoolId       String
  academicYearId String
  teacherId      String
  weekday        Int
  periodSlotId   String
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([academicYearId, teacherId, weekday, periodSlotId])
}

model TimetablePlan {
  id                       String           @id @default(uuid())
  schoolId                 String
  academicYearId           String
  classId                  String
  sectionId                String
  templateId               String
  status                   String           @default("DRAFT")
  version                  Int              @default(1)
  subjectConfigFingerprint String
  generatedAt              DateTime         @default(now())
  publishedAt              DateTime?
  entries                  TimetableEntry[]
  template                 PeriodTimingTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@unique([academicYearId, sectionId, version])
  @@index([schoolId, academicYearId, classId, sectionId, status])
}

model PeriodTimingTemplate {
  id              String                     @id @default(uuid())
  schoolId        String
  academicYearId  String
  familyId        String
  name            String
  description     String?
  workingDays     Int[]
  schoolStartTime String
  schoolEndTime   String
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  status          String                     @default("DRAFT")
  version         Int                        @default(1)
  createdById     String
  updatedById     String
  school          School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear               @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  createdBy       User                       @relation("PeriodTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User                       @relation("PeriodTemplateUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  slots           PeriodTimingSlot[]
  assignments     PeriodTemplateAssignment[]
  timetablePlans  TimetablePlan[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([schoolId, familyId, version])
  @@index([schoolId, academicYearId, status])
}

model PeriodTimingSlot {
  id                String               @id @default(uuid())
  templateId        String
  name              String
  type              String
  sequence          Int
  startTime         String
  endTime           String
  applicableDays    Int[]
  shortCode         String?
  attendanceEnabled Boolean              @default(false)
  template          PeriodTimingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  timetableEntries  TimetableEntry[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([templateId, sequence])
}

model PeriodTemplateAssignment {
  id             String               @id @default(uuid())
  schoolId       String
  academicYearId String
  templateId     String
  classId        String
  sectionId      String?
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  isActive       Boolean              @default(true)
  school         School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  template       PeriodTimingTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  schoolClass    SchoolClass          @relation(fields: [classId], references: [id], onDelete: Restrict)
  section        Section?             @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([templateId, classId, sectionId, effectiveFrom])
  @@index([schoolId, academicYearId, classId, sectionId, isActive])
}

model Homework {
  id             String               @id @default(uuid())
  schoolId       String
  academicYearId String
  classId        String
  sectionId      String
  subjectId      String
  title          String
  description    String?
  dueAt          DateTime
  status         String               @default("PUBLISHED")
  school         School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submissions    HomeworkSubmission[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([schoolId, academicYearId, classId, sectionId])
}

model HomeworkSubmission {
  id           String            @id @default(uuid())
  homeworkId   String
  enrollmentId String
  status       String            @default("PENDING")
  submittedAt  DateTime?
  score        Decimal?          @db.Decimal(8, 2)
  feedback     String?
  homework     Homework          @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([homeworkId, enrollmentId])
}

model LessonPlan {
  id              String   @id @default(uuid())
  schoolId        String
  academicYearId  String
  classId         String
  sectionId       String
  subjectId       String
  title           String
  objectives      String
  content         String?
  scheduledDate   DateTime
  syllabusUnit    String?
  coveragePercent Int      @default(0)
  status          String   @default("DRAFT")
  approvalComment String?
  syllabusTopicId String?
  syllabusTopic SyllabusTopic? @relation(fields: [syllabusTopicId], references: [id], onDelete: Restrict)
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, academicYearId, classId, sectionId])
}

model AiGeneration {
  id String @id @default(uuid())
  schoolId String
  userId String
  feature String
  model String
  promptVersion String
  input Json
  output Json
  status String @default("DRAFT")
  inputTokens Int?
  outputTokens Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId, userId, createdAt])
}

model Syllabus {
  id String @id @default(uuid())
  schoolId String
  academicYearId String
  classId String
  subjectId String
  termId String
  version Int
  status String @default("DRAFT")
  storageKey String
  fileName String
  fileHash String
  extractionWarning String?
  uploadedById String
  approvedById String?
  approvedAt DateTime?
  reviewedAt DateTime?
  supersededById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lessons SyllabusLesson[]
  topics SyllabusTopic[]
  @@unique([schoolId, academicYearId, classId, subjectId, termId, version])
  @@index([schoolId, academicYearId, classId, subjectId, termId, status])
}

model SchoolTerm {
  id String @id @default(uuid())
  schoolId String
  academicYearId String
  name String
  sortOrder Int
  createdAt DateTime @default(now())
  @@unique([schoolId, academicYearId, name])
  @@index([schoolId, academicYearId])
}

model SyllabusLesson {
  id String @id @default(uuid())
  schoolId String
  academicYearId String
  classId String
  subjectId String
  termId String
  syllabusId String
  title String
  sortOrder Int
  syllabus Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Restrict)
  topics SyllabusTopic[]
  @@unique([syllabusId, sortOrder])
  @@index([schoolId, academicYearId, classId, subjectId, termId])
}

model SyllabusTopic {
  id String @id @default(uuid())
  schoolId String
  academicYearId String
  classId String
  subjectId String
  termId String
  syllabusId String
  lessonId String
  title String
  sortOrder Int
  lesson SyllabusLesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  syllabus Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Restrict)
  lessonPlans LessonPlan[]
  @@unique([lessonId, sortOrder])
  @@index([schoolId, academicYearId, classId, subjectId, termId])
}

model ClassAnnouncement {
  id             String    @id @default(uuid())
  schoolId       String
  academicYearId String
  classId        String
  sectionId      String
  title          String
  message        String
  audience       String    @default("PARENTS_AND_STUDENTS")
  status         String    @default("DRAFT")
  publishedAt    DateTime?
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([schoolId, academicYearId, classId, sectionId])
}

model TimetableSubstitution {
  id                  String         @id @default(uuid())
  schoolId            String
  timetableEntryId    String
  date                DateTime
  substituteTeacherId String
  reason              String?
  status              String         @default("SCHEDULED")
  school              School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableEntry      TimetableEntry @relation(fields: [timetableEntryId], references: [id], onDelete: Cascade)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([timetableEntryId, date])
  @@index([schoolId, date])
}

model Exam {
  id             String        @id @default(uuid())
  schoolId       String
  academicYearId String
  name           String
  type           String
  startDate      DateTime?
  endDate        DateTime?
  status         String        @default("DRAFT")
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  subjects       ExamSubject[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([academicYearId, name])
  @@index([schoolId, academicYearId])
}

model ExamSubject {
  id           String        @id @default(uuid())
  examId       String
  classId      String
  subjectId    String
  examDate     DateTime?
  maximumMarks Decimal       @db.Decimal(8, 2)
  passingMarks Decimal       @db.Decimal(8, 2)
  exam         Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  schoolClass  SchoolClass   @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  marks        StudentMark[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([examId, classId, subjectId])
}

model StudentMark {
  id            String            @id @default(uuid())
  examSubjectId String
  enrollmentId  String
  marksObtained Decimal?          @db.Decimal(8, 2)
  isAbsent      Boolean           @default(false)
  remarks       String?
  examSubject   ExamSubject       @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  enrollment    StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([examSubjectId, enrollmentId])
}

model SchoolEvent {
  id          String    @id @default(uuid())
  schoolId    String
  title       String
  description String?
  eventType   String
  startsAt    DateTime
  endsAt      DateTime?
  audience    String    @default("ALL")
  location    String?
  status      String    @default("ACTIVE")
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId, startsAt])
}

model Notification {
  id          String    @id @default(uuid())
  schoolId    String
  recipientId String?
  channel     String
  title       String
  message     String
  status      String    @default("PENDING")
  sentAt      DateTime?
  readAt      DateTime?
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipient   User?     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId, recipientId, status])
}

model AuditLog {
  id         String   @id @default(uuid())
  schoolId   String?
  actorId    String?
  method     String
  path       String
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([actorId, createdAt])
}

model AcademicProgram {
  id String @id @default(uuid())
  schoolId String
  academicYearId String
  classId String
  sectionId String
  subjectId String
  syllabusId String
  name String
  status String @default("DRAFT")
  curriculum Json
  calendar Json
  revision Int @default(0)
  reviewedAt DateTime?
  approvedAt DateTime?
  approvedById String?
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions AcademicTeachingSession[]
  papers AcademicPaper[]
  interventions AcademicIntervention[]
  insights AcademicInsight[]
  @@index([schoolId, academicYearId, classId, sectionId, subjectId])
}

model AcademicTeachingSession {
  id String @id @default(uuid())
  programId String
  topicCode String
  title String
  scheduledDate DateTime @db.Date
  startTime String
  minutes Int
  status String @default("PLANNED")
  progressNotes String?
  lessonContent Json?
  generationId String?
  lessonPlanId String? @unique
  lessonStatus String @default("EMPTY")
  revision Int @default(0)
  reviewedAt DateTime?
  completedAt DateTime?
  program AcademicProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([programId, scheduledDate, startTime])
}

model AcademicPaper {
  id String @id @default(uuid())
  programId String
  kind String
  content Json
  dueDate DateTime @db.Date
  status String @default("DRAFT")
  revision Int @default(0)
  generationId String?
  homeworkId String? @unique
  examSubjectId String? @unique
  reviewedAt DateTime?
  publishedAt DateTime?
  program AcademicProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  results AcademicPaperResult[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([programId, status])
}

model AcademicPaperResult {
  id String @id @default(uuid())
  paperId String
  enrollmentId String
  absent Boolean @default(false)
  scores Json
  recordedById String
  paper AcademicPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([paperId, enrollmentId])
}

model AcademicIntervention {
  id String @id @default(uuid())
  programId String
  enrollmentId String
  topicCode String
  action String
  dueDate DateTime @db.Date
  status String @default("OPEN")
  outcome String?
  program AcademicProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([programId, enrollmentId])
}

model AcademicInsight {
  id String @id @default(uuid())
  programId String
  audience String
  enrollmentId String?
  content Json
  evidence Json
  generationId String?
  status String @default("DRAFT")
  revision Int @default(0)
  reviewedAt DateTime?
  publishedAt DateTime?
  program AcademicProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([programId, audience, enrollmentId, status])
}

model Parent {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationshipToStudent String?
  createdAt             DateTime @default(now())

  studentParents StudentParent[]
  memberships    ParentSchoolMembership[]
}

model ParentSchoolMembership {
  id                 String       @id @default(uuid())
  parentId           String
  schoolId           String
  parentCode         String
  occupation         String?
  status             ParentStatus @default(ACTIVE)
  verificationStatus String       @default("VERIFIED")
  verifiedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  parent             Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  school             School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([parentId, schoolId])
  @@unique([schoolId, parentCode])
  @@index([schoolId, status])
}

model StudentParent {
  id               String   @id @default(uuid())
  studentId        String
  parentId         String
  relationshipType String   @default("guardian")
  isPrimary        Boolean  @default(false)
  canPickup        Boolean  @default(true)
  canViewAcademics Boolean  @default(true)
  canPayFees       Boolean  @default(false)
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
}
