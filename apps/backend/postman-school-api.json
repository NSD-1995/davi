{
  "info": { "name": "DAVI School API — Complete", "description": "Complete API collection. Set baseUrl to the running backend. Run requests in the Setup workflow folder in order; response scripts store IDs and the JWT as collection variables.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api/v1" },
    { "key": "token", "value": "" },
    { "key": "schoolId", "value": "" },
    { "key": "academicYearId", "value": "" },
    { "key": "classId", "value": "" },
    { "key": "sectionId", "value": "" },
    { "key": "subjectId", "value": "" },
    { "key": "roleId", "value": "" },
    { "key": "permissionId", "value": "" },
    { "key": "staffId", "value": "" },
    { "key": "staffMobile", "value": "9876543210" },
    { "key": "staffTemporaryPassword", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "teacherId", "value": "" },
    { "key": "studentId", "value": "" },
    { "key": "parentId", "value": "" },
    { "key": "profileOptionId", "value": "" },
    { "key": "schoolAdminEmail", "value": "schooladmin@example.test" },
    { "key": "schoolAdminPassword", "value": "" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "item": [
    {
      "name": "00 — Setup workflow (run in order)",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}" } },
        { "name": "Register platform super-admin", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"superadmin@example.test\",\n  \"password\": \"ChangeMe123!\",\n  \"firstName\": \"Platform\",\n  \"lastName\": \"Admin\",\n  \"roles\": [\"super-admin\"],\n  \"mustChangePassword\": false\n}" }, "url": "{{baseUrl}}/auth/register" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('token', body.token);", "pm.collectionVariables.set('userId', body.user.id);"] } }] },
        { "name": "Create school (super-admin token required)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Bright Valley Academy\",\n  \"shortName\": \"BVA\",\n  \"address\": \"123 Main Street\",\n  \"city\": \"Nairobi\",\n  \"country\": \"Kenya\",\n  \"phone\": \"+254700000000\",\n  \"email\": \"admin@brightvalley.test\",\n  \"adminEmail\": \"{{schoolAdminEmail}}\",\n  \"adminFirstName\": \"Jane\",\n  \"adminLastName\": \"Mwangi\"\n}" }, "url": "{{baseUrl}}/schools" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('schoolId', body.school.id);", "pm.collectionVariables.set('schoolAdminPassword', body.temporaryPassword);"] } }] },
        { "name": "Login as school admin", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{schoolAdminEmail}}\",\n  \"password\": \"{{schoolAdminPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('token', body.token);", "pm.collectionVariables.set('userId', body.user.id);"] } }] },
        { "name": "Change school admin password", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"{{schoolAdminPassword}}\",\n  \"newPassword\": \"ChangeMe123!\"\n}" }, "url": "{{baseUrl}}/auth/change-password" } },
        { "name": "Create school settings", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"schoolId\": \"{{schoolId}}\",\n  \"schoolName\": \"Bright Valley Academy\",\n  \"timezone\": \"Africa/Nairobi\",\n  \"language\": \"en\",\n  \"gradingSystem\": \"percentage\"\n}" }, "url": "{{baseUrl}}/school-settings" } },
        { "name": "Create academic year (school-admin token required)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"2026-2027\",\n  \"startDate\": \"2026-01-05T00:00:00.000Z\",\n  \"endDate\": \"2027-12-15T00:00:00.000Z\",\n  \"isCurrent\": true,\n  \"status\": \"ACTIVE\"\n}" }, "url": "{{baseUrl}}/academic-years" }, "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('academicYearId', pm.response.json().id);"] } }] },
        { "name": "Create 1st Standard with 3 sections (school-admin token required)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"academicYearId\": \"{{academicYearId}}\",\n  \"name\": \"1st Standard\",\n  \"code\": \"STD-1\",\n  \"capacity\": 120,\n  \"numberOfSections\": 3,\n  \"sectionCapacity\": 40\n}" }, "url": "{{baseUrl}}/classes" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('classId', body.id);", "if (body.sections?.[0]) pm.collectionVariables.set('sectionId', body.sections[0].id);"] } }] },
        { "name": "Create additional section (school-admin token required)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"classId\": \"{{classId}}\",\n  \"name\": \"4\",\n  \"capacity\": 40\n}" }, "url": "{{baseUrl}}/sections" }, "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('sectionId', pm.response.json().id);"] } }] },
        { "name": "Create subject", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"schoolId\": \"{{schoolId}}\",\n  \"name\": \"Mathematics\",\n  \"code\": \"MATH\",\n  \"type\": \"CORE\"\n}" }, "url": "{{baseUrl}}/subjects" }, "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('subjectId', pm.response.json().id);"] } }] }
      ]
    },
    { "name": "Auth", "item": [
      { "name": "Register user", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"schoolId\": \"{{schoolId}}\",\n  \"email\": \"teacher@example.test\",\n  \"password\": \"ChangeMe123!\",\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Teacher\",\n  \"roles\": [\"teacher\"],\n  \"mustChangePassword\": false\n}" }, "url": "{{baseUrl}}/auth/register" } },
      { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"teacher@example.test\",\n  \"password\": \"ChangeMe123!\"\n}" }, "url": "{{baseUrl}}/auth/login" } },
      { "name": "Staff Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{staffMobile}}\",\n  \"password\": \"{{staffTemporaryPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] } }] },
      { "name": "Change First-Time Password", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"{{staffTemporaryPassword}}\",\n  \"newPassword\": \"NewPassword123!\"\n}" }, "url": "{{baseUrl}}/auth/change-password" } },
      { "name": "Current User / Permissions", "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" } }
    ] },
    { "name": "Schools", "item": [
      { "name": "Create school", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"New School\",\n  \"adminEmail\": \"new-admin@example.test\"\n}" }, "url": "{{baseUrl}}/schools" } },
      { "name": "List schools", "request": { "method": "GET", "url": "{{baseUrl}}/schools" } },
      { "name": "Get school", "request": { "method": "GET", "url": "{{baseUrl}}/schools/{{schoolId}}" } },
      { "name": "Update school", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"city\": \"Mombasa\" }" }, "url": "{{baseUrl}}/schools/{{schoolId}}" } },
      { "name": "Delete school", "request": { "method": "DELETE", "url": "{{baseUrl}}/schools/{{schoolId}}" } },
      { "name": "School students", "request": { "method": "GET", "url": "{{baseUrl}}/schools/{{schoolId}}/students" } },
      { "name": "School teachers", "request": { "method": "GET", "url": "{{baseUrl}}/schools/{{schoolId}}/teachers" } },
      { "name": "School parents", "request": { "method": "GET", "url": "{{baseUrl}}/schools/{{schoolId}}/parents" } },
      { "name": "List profile options", "request": { "method": "GET", "url": "{{baseUrl}}/schools/{{schoolId}}/profile-options" } },
      { "name": "Create profile option", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"key\": \"student_code\", \"label\": \"Student Code\", \"type\": \"text\", \"isRequired\": true }" }, "url": "{{baseUrl}}/schools/{{schoolId}}/profile-options" }, "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('profileOptionId', pm.response.json().id);"] } }] },
      { "name": "Update profile option", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"label\": \"Student Registration Code\" }" }, "url": "{{baseUrl}}/schools/{{schoolId}}/profile-options/{{profileOptionId}}" } },
      { "name": "Delete profile option", "request": { "method": "DELETE", "url": "{{baseUrl}}/schools/{{schoolId}}/profile-options/{{profileOptionId}}" } },
      { "name": "User profile values", "request": { "method": "GET", "url": "{{baseUrl}}/schools/{{schoolId}}/users/{{userId}}/profile-options" } },
      { "name": "Add user profile value", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"optionId\": \"{{profileOptionId}}\", \"value\": \"ST-2026-001\" }" }, "url": "{{baseUrl}}/schools/{{schoolId}}/users/{{userId}}/profile-options" } },
      { "name": "Delete user profile value", "request": { "method": "DELETE", "url": "{{baseUrl}}/schools/{{schoolId}}/users/{{userId}}/profile-options/{{profileOptionId}}" } }
    ] },
    { "name": "School settings", "item": [
      { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"schoolId\": \"{{schoolId}}\", \"timezone\": \"Africa/Nairobi\" }" }, "url": "{{baseUrl}}/school-settings" } },
      { "name": "List", "request": { "method": "GET", "url": "{{baseUrl}}/school-settings" } },
      { "name": "Get by ID", "request": { "method": "GET", "url": "{{baseUrl}}/school-settings/{{schoolId}}" } },
      { "name": "Get by school", "request": { "method": "GET", "url": "{{baseUrl}}/school-settings/schools/{{schoolId}}" } },
      { "name": "Update", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"language\": \"sw\" }" }, "url": "{{baseUrl}}/school-settings/{{schoolId}}" } },
      { "name": "Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/school-settings/{{schoolId}}" } }
    ] },
    { "name": "Academic years", "item": [
      { "name": "Create (school-admin token required)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"name\": \"2027-2028\" }" }, "url": "{{baseUrl}}/academic-years" } },
      { "name": "List", "request": { "method": "GET", "url": "{{baseUrl}}/academic-years" } }, { "name": "Get", "request": { "method": "GET", "url": "{{baseUrl}}/academic-years/{{academicYearId}}" } }, { "name": "By school", "request": { "method": "GET", "url": "{{baseUrl}}/academic-years/schools/{{schoolId}}" } },
      { "name": "Update", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"isCurrent\": true }" }, "url": "{{baseUrl}}/academic-years/{{academicYearId}}" } }, { "name": "Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/academic-years/{{academicYearId}}" } }
    ] },
    { "name": "Classes", "item": [
      { "name": "One-step setup by class group (school-admin token required)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"academicYearId\": \"{{academicYearId}}\",\n  \"numberOfSections\": 3,\n  \"sectionCapacity\": 40,\n  \"montessori\": true,\n  \"primary\": true,\n  \"secondary\": true,\n  \"seniorSecondary\": true\n}" }, "url": "{{baseUrl}}/classes/bulk" } },
      { "name": "Create (school-admin token required)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"academicYearId\": \"{{academicYearId}}\", \"name\": \"2nd Standard\", \"numberOfSections\": 2 }" }, "url": "{{baseUrl}}/classes" } }, { "name": "List all", "request": { "method": "GET", "url": "{{baseUrl}}/classes" } }, { "name": "List active (dashboard default)", "request": { "method": "GET", "url": "{{baseUrl}}/classes?status=ACTIVE" } }, { "name": "List inactive", "request": { "method": "GET", "url": "{{baseUrl}}/classes?status=INACTIVE" } }, { "name": "Get", "request": { "method": "GET", "url": "{{baseUrl}}/classes/{{classId}}" } }, { "name": "By school", "request": { "method": "GET", "url": "{{baseUrl}}/classes/schools/{{schoolId}}" } }, { "name": "Deactivate (hide/disable in UI)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"INACTIVE\" }" }, "url": "{{baseUrl}}/classes/{{classId}}" } }, { "name": "Reactivate", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"ACTIVE\" }" }, "url": "{{baseUrl}}/classes/{{classId}}" } }, { "name": "Update", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"capacity\": 45 }" }, "url": "{{baseUrl}}/classes/{{classId}}" } }, { "name": "Delete (also deletes its sections)", "request": { "method": "DELETE", "url": "{{baseUrl}}/classes/{{classId}}" } }
    ] },
    { "name": "Sections", "item": [
      { "name": "Create (school-admin token required)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"classId\": \"{{classId}}\", \"name\": \"4\" }" }, "url": "{{baseUrl}}/sections" } }, { "name": "List", "request": { "method": "GET", "url": "{{baseUrl}}/sections" } }, { "name": "Get", "request": { "method": "GET", "url": "{{baseUrl}}/sections/{{sectionId}}" } }, { "name": "By school", "request": { "method": "GET", "url": "{{baseUrl}}/sections/schools/{{schoolId}}" } }, { "name": "By class", "request": { "method": "GET", "url": "{{baseUrl}}/sections/classes/{{classId}}" } }, { "name": "Update", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"capacity\": 30 }" }, "url": "{{baseUrl}}/sections/{{sectionId}}" } }, { "name": "Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/sections/{{sectionId}}" } }
    ] },
    { "name": "Subjects", "item": [
      { "name": "Create Subject", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"schoolId\": \"{{schoolId}}\",\n  \"name\": \"English\",\n  \"code\": \"ENG\",\n  \"description\": \"English language subject\",\n  \"type\": \"CORE\",\n  \"status\": \"ACTIVE\"\n}" }, "url": "{{baseUrl}}/subjects" }, "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('subjectId', pm.response.json().id);"] } }] },
      { "name": "Get Subjects", "request": { "method": "GET", "url": "{{baseUrl}}/subjects" } },
      { "name": "Get Subject By ID", "request": { "method": "GET", "url": "{{baseUrl}}/subjects/{{subjectId}}" } },
      { "name": "Get Subjects By School", "request": { "method": "GET", "url": "{{baseUrl}}/subjects/schools/{{schoolId}}?status=ACTIVE" } },
      { "name": "Update Subject", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Advanced English\",\n  \"description\": \"Updated language subject\",\n  \"status\": \"ACTIVE\"\n}" }, "url": "{{baseUrl}}/subjects/{{subjectId}}" } },
      { "name": "Delete Subject", "request": { "method": "DELETE", "url": "{{baseUrl}}/subjects/{{subjectId}}" } }
    ] },
    { "name": "Academic Year Subjects", "item": [
      { "name": "Assign Subjects", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"schoolId\": \"{{schoolId}}\",\n  \"subjectIds\": [\"{{subjectId}}\"]\n}" }, "url": "{{baseUrl}}/academic-years/{{academicYearId}}/subjects" } },
      { "name": "Get Subjects By Academic Year", "request": { "method": "GET", "url": "{{baseUrl}}/academic-years/{{academicYearId}}/subjects" } },
      { "name": "Remove Subject From Academic Year", "request": { "method": "DELETE", "url": "{{baseUrl}}/academic-years/{{academicYearId}}/subjects/{{subjectId}}" } }
    ] },
    { "name": "Roles", "item": [
      { "name": "Create Role", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Exam Coordinator\",\n  \"code\": \"EXAM_COORDINATOR\",\n  \"description\": \"Manages school exams and marks\"\n}" }, "url": "{{baseUrl}}/schools/{{schoolId}}/roles" }, "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('roleId', pm.response.json().id);"] } }] },
      { "name": "List School Roles", "request": { "method": "GET", "url": "{{baseUrl}}/schools/{{schoolId}}/roles" } },
      { "name": "Get Role", "request": { "method": "GET", "url": "{{baseUrl}}/schools/{{schoolId}}/roles/{{roleId}}" } },
      { "name": "Update Role", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"description\": \"Updated access\" }" }, "url": "{{baseUrl}}/schools/{{schoolId}}/roles/{{roleId}}" } },
      { "name": "Delete Role", "request": { "method": "DELETE", "url": "{{baseUrl}}/schools/{{schoolId}}/roles/{{roleId}}" } }
    ] },
    { "name": "Permissions", "item": [
      { "name": "List Permissions", "request": { "method": "GET", "url": "{{baseUrl}}/permissions" }, "event": [{ "listen": "test", "script": { "exec": ["const groups = pm.response.json();", "if (groups[0]?.permissions[0]) pm.collectionVariables.set('permissionId', groups[0].permissions[0].id);"] } }] },
      { "name": "Get Role Permissions", "request": { "method": "GET", "url": "{{baseUrl}}/schools/{{schoolId}}/roles/{{roleId}}/permissions" } },
      { "name": "Update Role Permissions", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"permissionIds\": [\"{{permissionId}}\"]\n}" }, "url": "{{baseUrl}}/schools/{{schoolId}}/roles/{{roleId}}/permissions" } }
    ] },
    { "name": "Staff", "item": [
      { "name": "Create Staff", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Ravi\",\n  \"lastName\": \"Kumar\",\n  \"mobile\": \"{{staffMobile}}\",\n  \"email\": \"ravi@example.com\",\n  \"employeeId\": \"EMP001\",\n  \"joiningDate\": \"2026-06-01\",\n  \"roleId\": \"{{roleId}}\"\n}" }, "url": "{{baseUrl}}/schools/{{schoolId}}/staff" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('staffId', body.staff.id);", "pm.collectionVariables.set('staffTemporaryPassword', body.credentials.temporaryPassword);"] } }] },
      { "name": "List Staff", "request": { "method": "GET", "url": "{{baseUrl}}/schools/{{schoolId}}/staff" } },
      { "name": "Get Staff", "request": { "method": "GET", "url": "{{baseUrl}}/schools/{{schoolId}}/staff/{{staffId}}" } },
      { "name": "Update Staff", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"lastName\": \"Kumar Updated\" }" }, "url": "{{baseUrl}}/schools/{{schoolId}}/staff/{{staffId}}" } },
      { "name": "Deactivate Staff", "request": { "method": "DELETE", "url": "{{baseUrl}}/schools/{{schoolId}}/staff/{{staffId}}" } }
    ] },
    { "name": "Users", "item": [
      { "name": "Create (passwordHash is required)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"schoolId\": \"{{schoolId}}\", \"email\": \"manual-user@example.test\", \"passwordHash\": \"pre-hashed-password\", \"firstName\": \"Manual\", \"lastName\": \"User\" }" }, "url": "{{baseUrl}}/users" } }, { "name": "List", "request": { "method": "GET", "url": "{{baseUrl}}/users" } }, { "name": "Get", "request": { "method": "GET", "url": "{{baseUrl}}/users/{{userId}}" } }, { "name": "Update", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"phone\": \"+254700000999\" }" }, "url": "{{baseUrl}}/users/{{userId}}" } }, { "name": "Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/users/{{userId}}" } }, { "name": "List user roles", "request": { "method": "GET", "url": "{{baseUrl}}/users/{{userId}}/roles" } }, { "name": "Assign role", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"roleName\": \"teacher\" }" }, "url": "{{baseUrl}}/users/{{userId}}/roles" } }, { "name": "Remove role", "request": { "method": "DELETE", "url": "{{baseUrl}}/users/{{userId}}/roles/{{roleId}}" } }
