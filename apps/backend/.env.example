DATABASE_URL="postgresql://davi:davi123@localhost:5432/davi?schema=public"
FRONTEND_URL="http://localhost:3000"

# Text-based AI lesson generation. Add your API key to the local .env only.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"

# Montessori admission seeder (use a current School Admin JWT from POST /auth/login)
DAVI_TOKEN=""
ACADEMIC_YEAR_ID=""
CLASS_ID=""
# Optional: omit to admit all students into the class allocation pool.
SECTION_ID=""
STUDENT_COUNT="30"
SEED_START="1"
SEED_PREFIX="MONT-2026"
CORS_ORIGINS="http://localhost:3000"

# Local account creation only. Ignored when NODE_ENV=production.
DEVELOPMENT_DEFAULT_PASSWORD="Davi-123456"

# School branding media. Local files are never exposed as a public directory.
MEDIA_STORAGE_PROVIDER="local"
MEDIA_STORAGE_DIR="./private-media"
# Optional in local development. Production always requires the configured ClamAV scanner.
MEDIA_SCAN_REQUIRED="false"
# Reuse MIGRATION_CLAMD_HOST and MIGRATION_CLAMD_PORT for ClamAV.
# Future cloud adapters must implement the MediaStorageProvider contract; no S3 adapter is enabled yet.
